    {"id":"clean-input","source":"capture","target":"clean","label":"route timestamped observation batch"},
    {"id":"baseline","source":"registry","target":"clean","label":"retrieve protocol baseline","style":"dashed","semanticClass":"optional"},
    {"id":"derive","source":"clean","target":"catalog","label":"derive quality-controlled features"},
    {"id":"simulate","source":"catalog","target":"simulator","label":"seed synthetic control scenarios"},
    {"id":"fit","source":"catalog","target":"model","label":"provide descriptor matrix for constrained fitting"},
