    {"id":"portal","source":"paper","target":"public-ref","label":"publish synthetic dataset metadata"},
    {"id":"archive-link","source":"raw","target":"archive-ref","label":"link retained raw archive metadata","semanticClass":"secondary"},
    {"id":"feedback-data","source":"review","target":"clean","label":"send anomaly feedback to cleaning pipeline","style":"dashed","semanticClass":"alert"},
