{
  "version": 1,
  "direction": "AUTO",
  "layoutGoal": "fit-page",
  "page": {"width":3000,"height":1500,"margin":24,"minBodyFontSize":9,"orientation":"landscape","minStrokeWidth":0.5},
  "theme": {"visual":true,"crossingBridges":true,"colorMode":"proximity","groupEdgesByAction":true,"labelWidth":104},
  "nodes": [
    {"id":"request","title":"Experiment request","kind":"screen","rows":[{"role":"input","required":true,"label":"Research question"},{"role":"cta","text":"Open study"}]},
    {"id":"scope","title":"Scope review","kind":"dialog","rows":[{"role":"shown","text":"Check novelty and resources"},{"role":"condition","predicate":"Scope is feasible","then":"Approve plan","thenRole":"cta"}]},
    {"id":"protocol","title":"Protocol studio","kind":"screen","rows":[{"role":"shown","text":"Specify controls and sampling"},{"role":"rule","text":"Every revision keeps an audit trail"}]},
    {"id":"registry","title":"Protocol registry","kind":"boundary","rows":[{"role":"shown","text":"Immutable protocol revision"}]},
    {"id":"sensor","title":"Sensor array","kind":"external","rows":[{"role":"shown","text":"Fictional coastal observatory"}]},
    {"id":"capture","title":"Capture gateway","kind":"screen","rows":[{"role":"shown","text":"Batch and timestamp readings"}]},
    {"id":"raw","title":"Raw archive","kind":"boundary","rows":[{"role":"shown","text":"Encrypted observation objects"}]},
    {"id":"clean","title":"Cleaning pipeline","kind":"screen","rows":[{"role":"condition","predicate":"Quality flags pass","then":"Normalize stream","thenRole":"cta"},{"role":"warning","text":"Quarantine anomalous batches"}]},
    {"id":"catalog","title":"Feature catalog","kind":"screen","rows":[{"role":"shown","text":"Traceable derived variables"}]},
    {"id":"simulator","title":"Scenario simulator","kind":"dialog","rows":[{"role":"shown","text":"Generate synthetic controls"},{"role":"cta","text":"Run scenario"}]},
    {"id":"model","title":"Model workshop","kind":"screen","rows":[{"role":"shown","text":"Fit constrained response families"},{"role":"rule","text":"Compare against held-out controls"}]},
    {"id":"validation","title":"Validation bench","kind":"dialog","rows":[{"role":"input","required":true,"label":"Acceptance threshold"},{"role":"cta","text":"Validate candidate"}]},
    {"id":"review","title":"Evidence review","kind":"screen","rows":[{"role":"shown","text":"Inspect diagnostics and uncertainty"}]},
    {"id":"revision","title":"Revision queue","kind":"screen","rows":[{"role":"note","text":"Route feedback to the owning stage"}]},
    {"id":"figures","title":"Figure assembly","kind":"screen","rows":[{"role":"shown","text":"Generate annotated panels"}]},
    {"id":"appendix","title":"Appendix bundle","kind":"boundary","rows":[{"role":"shown","text":"Methods and provenance tables"}]},
    {"id":"paper","title":"Paper package","kind":"boundary","rows":[{"role":"shown","text":"Synthetic study report"}]},
    {"id":"public-ref","title":"Data portal","kind":"screen","presentation":"reference","canonicalNodeId":"public-data-portal","showcasePage":2},
    {"id":"archive-ref","title":"Archive details","kind":"screen","presentation":"reference","canonicalNodeId":"raw-archive-specification","showcasePage":3}
  ],
  "edges": [
