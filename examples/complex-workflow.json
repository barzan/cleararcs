    {"id":"cross-e","source":"catalog","target":"appendix","label":"summarize feature lineage","semanticClass":"secondary"},
    {"id":"cross-f","source":"sensor","target":"public-ref","label":"describe instrument channel availability","semanticClass":"secondary"},
    {"id":"cross-g","source":"request","target":"revision","label":"preserve original question when revisions occur","semanticClass":"secondary"},
    {"id":"cross-h","source":"validation","target":"paper","label":"record acceptance decision","semanticClass":"secondary"},
    {"id":"cross-i","source":"raw","target":"model","label":"audit raw sample traceability","style":"dashed","semanticClass":"optional"},
    {"id":"cross-j","source":"protocol","target":"appendix","label":"supply parameter definitions","semanticClass":"secondary"},
